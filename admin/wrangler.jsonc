// Admin panel: its pages (public/) plus the admin backend (backend/index.js).
// Deploy from this folder with `npx wrangler deploy` (Cloudflare project root
// directory: admin), on the admin subdomain. Deploy hp-fresh-fruits first.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "hpadmin",
  "main": "backend/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  // Calls the customer site's backend (hp-fresh-fruits) directly inside Cloudflare.
  "services": [{ "binding": "SHOP_API", "service": "hp-fresh-fruits" }],
  // Set in the dashboard and kept between deploys:
  //   ADMIN_EMAIL, SESSION_SECRET, INTERNAL_API_KEY (secrets)
  //   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET (secrets, for "Sign in with Google")
  //   ADMIN_PASSWORD (optional secret, for email + password sign-in)
  //   SHOP_URL (optional text, the shop's address for the "Open customer site" link)
  "keep_vars": true,
  "observability": { "enabled": true }
}
