// Admin backend: serves the admin panel's pages (../admin) and its API.
// Deploy from this folder with `npx wrangler deploy` (Cloudflare project root: admin-api),
// on the admin subdomain (e.g. admin.yourdomain.com). Deploy fruit-shop first.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "fruit-shop-admin",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../admin",
    "binding": "ASSETS"
  },
  // Calls the storefront backend's private API directly inside Cloudflare.
  "services": [{ "binding": "SHOP_API", "service": "fruit-shop" }],
  // Set in the dashboard and kept between deploys:
  //   ADMIN_PASSWORD, SESSION_SECRET, INTERNAL_API_KEY (secrets)
  //   SHOP_URL (optional text, the shop's address for the "View shop" link)
  "keep_vars": true,
  "observability": { "enabled": true }
}
